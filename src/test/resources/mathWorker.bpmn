<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_MathWorker" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="mathWorker" name="mathWorker" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_ToAddition</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Addition" name="Add a and b">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="addition" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=if a = null then 10 else a" target="a" />
          <zeebe:input source="=if b = null then 5 else b" target="b" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAddition</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMultiplication</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Multiplication" name="Multiply a and b">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="multiplication" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=if a = null then 10 else a" target="a" />
          <zeebe:input source="=if b = null then 5 else b" target="b" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToMultiplication</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDivision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Division" name="Divide a by b">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="division" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=if a = null then 10 else a" target="a" />
          <zeebe:input source="=if b = null then 5 else b" target="b" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDivision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_ReviewResults" name="Review results">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-results-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToAddition" sourceRef="StartEvent_1" targetRef="Task_Addition" />
    <bpmn:sequenceFlow id="Flow_ToMultiplication" sourceRef="Task_Addition" targetRef="Task_Multiplication" />
    <bpmn:sequenceFlow id="Flow_ToDivision" sourceRef="Task_Multiplication" targetRef="Task_Division" />
    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="Task_Division" targetRef="UserTask_ReviewResults" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="UserTask_ReviewResults" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="mathWorker">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Addition_di" bpmnElement="Task_Addition">
        <dc:Bounds x="240" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Multiplication_di" bpmnElement="Task_Multiplication">
        <dc:Bounds x="400" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Division_di" bpmnElement="Task_Division">
        <dc:Bounds x="560" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ReviewResults_di" bpmnElement="UserTask_ReviewResults">
        <dc:Bounds x="720" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="880" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToAddition_di" bpmnElement="Flow_ToAddition">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToMultiplication_di" bpmnElement="Flow_ToMultiplication">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="400" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDivision_di" bpmnElement="Flow_ToDivision">
        <di:waypoint x="500" y="120" />
        <di:waypoint x="560" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToReview_di" bpmnElement="Flow_ToReview">
        <di:waypoint x="660" y="120" />
        <di:waypoint x="720" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="820" y="120" />
        <di:waypoint x="880" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>